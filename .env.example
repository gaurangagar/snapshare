# SnapShare Environment Configuration

# Neon Serverless PostgreSQL Database URLs
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# JWT Secret for Session & PIN tokens
JWT_SECRET=""

# (Optional) S3-Compatible Cloud Object Storage (Cloudflare R2 / AWS S3 / MinIO)
# If omitted, SnapShare will automatically store uploads in public/uploads/
# S3_BUCKET_NAME="snapshare-bucket"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_REGION="auto"
# AWS_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_PUBLIC_URL="https://pub-<id>.r2.dev"
